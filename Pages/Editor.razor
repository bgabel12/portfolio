@page "/editor"
@using Append.Blazor.Downloads
@inject HttpClient http
@inject NavigationManager NavManager
@inject IDownloadService DownloadService
@inject IJSRuntime jsRuntime

<div class="row justify-content-center">
  <hr class="mt-5 mb-3" />
  <div class="row row-gap-2 align-items-end" style="min-width: 770px;max-width: 1080px;">
    <div class="col-12 fw-bold text-center">
      <h3>Project Editor</h3>
    </div>
    <div class="col-12 text-center">
      <RadzenDropDown @bind-Value=@ProjectIconCssClassValue Data=@IconCssClasses Placeholder="Icon" Style="width: 200px;">
        <Template>
          @{
            var iconClass = (string)context;
            var iconName = iconClass.Replace("bi ", "").Replace(" colored", ""); // removes prepend & append classes
            iconName = iconName.Replace("bi-", "").Replace("devicon-", "").Replace("-fill", "").Replace("-plain", "");
          }
          <i class="@iconClass" title="@iconClass" style="font-size: 16px;"></i> @iconName
        </Template>
      </RadzenDropDown>
      <RadzenTextBox @bind-Value=@ProjectNameValue Style="width: 200px;" Placeholder="Project Name" />
      <RadzenTextBox @bind-Value=@ProjectDescriptionValue Style="width: auto;" Placeholder="Project Description" />
      <RadzenButton Click="CreateProject" Text="Create" Size="ButtonSize.Small" Style="width: auto;" />
    </div>

    <div class="col-12 text-center">
      <RadzenDropDown Name="ProjectNamesDropDown" @bind-Value=@ProjectNamesValue Data=@ProjectNames Placeholder="Select Project" Style="width: 200px;" />
      <RadzenButton Click="LoadProject" Text="Load" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Style="width: auto;" />
    </div>    

    <div class="col-12"><hr /></div>

    <div class="col-2 fw-bold fs-4 text-primary text-center">
      @(!string.IsNullOrEmpty(ProjectNameValue) ? ProjectNameValue : ProjectNamesValue)
    </div>
    <div class="col-6">
      @foreach (var tech in SelectedProjectTechnologies)
      {
        <span class="me-2 white-space-no-wrap"><i class="@tech.IconCssClass"></i> @tech.Name</span>
      }
    </div>
    <div class="col-2">
      <RadzenButton Click=@OpenTechAsync Text="Edit Tech." ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small" />
    </div>
    <div class="col-2 text-end">
      <RadzenButton Click=@DownloadFromStreamAsync Text="Download" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" />
    </div>
  </div>
  <div class="grip mt-2">
    <RadzenHtmlEditor @bind-Value=@HtmlValue 
    Input=@OnEditorInput 
    Change=@OnEditorChange 
    Paste=@OnEditorPaste
    Execute=@OnEditorExecute
    style="width: 100%; height: 100%;margin-bottom: 1rem;">
    </RadzenHtmlEditor>
  </div>
</div>

<!-- Technologies Modal -->
<div class="modal fade" id="techModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Edit Technologies</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">

        <div class="row mb-3">
          <div class="col-4">
            <RadzenDropDown @bind-Value=@TechIconCssClassValue Data=@TechIconCssClasses Placeholder="Icon" Style="width: 150px;">
              <Template>
                @{
                  var iclass = (string)context;
                  var iname = iclass.Replace("bi ", "").Replace(" colored", ""); // removes prepend & append classes
                  iname = iname.Replace("bi-", "").Replace("devicon-", "").Replace("-fill", "").Replace("-plain", "");
                }
                <i class="@iclass" title="@iname" style="font-size: 16px;"></i> @iname
              </Template>
            </RadzenDropDown>
          </div>
          <div class="col">
            <RadzenTextBox @bind-Value=@TechNameValue Placeholder="ie: React" Style="width: 150px;" />
            <RadzenButton Click=@AddTech Text="Add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" />
          </div>
        </div>
        <div class="row">
          <div class="col text-center">
            <RadzenDropDown @bind-Value=@TechnologyValue Data=@SelectedProjectTechnologies Placeholder="Technologies" Style="width: 200px;">
              <Template>
                @{
                  var tech = (ProjectTechnology)context;
                }
                <i class="@tech.IconCssClass" style="font-size: 16px;"></i> @tech.Name
              </Template>
            </RadzenDropDown>
            <RadzenButton Click=@ConfirmDeleteTechAsync Text="Delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" />
          </div>
        </div>

      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- Confirm Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="confirmModalLabel">Confirm @ConfirmAction</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="confirmModalBody">
        @ConfirmMsg
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="confirmModalYes" class="btn btn-primary" @onclick=@OnConfirmAsync>Yes</button>
      </div>
    </div>
  </div>
</div>
