@page "/"
@inject IJSRuntime jsRuntime
@inject HttpClient http

<PageTitle>Brent Gabel</PageTitle>

<div class="mt-5 container">
  <!-- Hero Section -->
  <section class="mb-5 text-center">
    <h1 class="display-4"><span class="text-primary">Brent Gabel</span></h1>
    <p class="lead">Senior Software Engineer | Cloud Infrastructure</p>
    <div class="d-print-none d-flex justify-content-center gap-3">
      <a href="https://www.linkedin.com/in/brent-gabel-a327569" class="btn btn-primary">
        <i class="bi bi-linkedin"></i> LinkedIn
      </a>
      <a href="content/Brent Gabel - Resume.pdf" class="btn btn-outline-primary" download>
        <i class="bi bi-file-earmark-arrow-down"></i> Download Resume
      </a>
    </div>
  </section>

  <!-- About Me Section -->
  <section id="about" class="mb-5">
    <div class="container">
      <div class="row d-flex align-items-center">
        <div class="col-md-4 text-center">
          <img src="images/profile.jpg" class="img-fluid rounded-circle" alt="Profile Picture">
        </div>
        <div class="col-md-8">
          <h2>About Me</h2>
          <p>
            I'm Brent Gabel, a Senior Software Engineer with over a decade of experience in software development, automation, and cloud infrastructure. 
            My journey in tech started with early explorations in ASP.NET, VBScript, PHP, and C++, building web applications and diving deep into database structuring and network architecture. 
            Over the years, I’ve evolved into a full-stack engineer with a strong focus on Azure-based architectures, microservices, and automation strategies.
          </p>
          <p>
            I thrive on solving complex problems and architecting scalable solutions. 
            Whether it’s designing cloud-native applications, implementing CI/CD pipelines, or optimizing high-performance systems, I enjoy bringing efficiency and innovation to every project I work on. 
            My experience spans .NET, C#, Azure, containerized deployments, and API-driven architectures, and I’m always eager to push the boundaries of modern software development.
          </p>
          <p>
            Beyond coding, I enjoy mentoring engineers, streamlining development workflows, and collaborating with teams to build high-quality software. 
            When I’m not writing code, you can find me exploring new advancements in cloud computing, testing out emerging DevOps tools, or refining system architectures for better performance.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Section -->
  <ProjectsComponent />

  <!-- Work Experience Section -->
  <section id="experience" class="mb-5">
    <h2 class="mb-4 text-center"><i class="bi bi-person-workspace"></i> Work Experience</h2>
    <div class="container">
      <!-- Experience 1 -->
      <div class="mb-4">
        <h4 class="mb-1">Senior Software Engineer</h4>
        <h6 class="text-muted">ECI Software Solutions / Lojic, LLC | United States</h6>
        <p class="text-muted">Nov 2018 - Nov 2024</p>
        <ul class="mb-0">
          <li>Designed, developed, and deployed Azure cloud-native application solutions using Azure Function Apps, .NET Core, C#, Blazor WASM, Blazor Server, Durable Function Apps, Azure SQL Server, and Azure MySQL for client and internal applications.</li>
          <li>Led requirements analysis and software design efforts, collaborating with cross-functional teams to deliver high-quality products.</li>
          <li>Provided mentorship and technical guidance to junior engineers, fostering a culture of continuous learning and innovation.</li>
        </ul>
      </div>
      <hr class="border-top border-secondary-subtle" />
      <!-- Experience 2 -->
      <div class="mb-4">
        <h4 class="mb-1">Director of Applications and Automation</h4>
        <h6 class="text-muted">Project Hosts, Inc. | United States</h6>
        <p class="text-muted">Sept 2016 - Nov 2018</p>
        <ul class="mb-0">
          <li>Spearheaded automation strategies to streamline software deployment and cloud infrastructure management.</li>
          <li>Provided mentorship and technical guidance to junior engineers.</li>
        </ul>
      </div>
      <hr class="border-top border-secondary-subtle" />
      <!-- Experience 3 -->
      <div class="mb-4">
        <h4 class="mb-1">Senior Software Engineer / Operations Support Engineer</h4>
        <h6 class="text-muted">Project Hosts, Inc. | United States</h6>
        <p class="text-muted">Jan 2011 - Sept 2016</p>
        <ul class="mb-0">
          <li>Developed and maintained internal tools for monitoring, logging, and system diagnostics.</li>
          <li>Provided technical support for customers and assisted the sales team with technical inquiries.</li>
        </ul>
      </div>
    </div>
  </section>

  <SkillsComponent DisplayShowCaseSkills="true" DisplayAllSkills="true" AllSkillsButton="true"></SkillsComponent>

  <!-- Favorite Podcasts Section -->
  <section id="podcasts" class="d-print-none mt-5 mb-5">
    <h2 class="text-center"><i class="fas fa-podcast"></i> My Favorite Podcasts</h2>
    <div class="container">
      <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Security This Week -->
        <div class="col">
          <div class="card border-primary h-100 shadow-sm">
            <div class="card-body text-center">
              <h5 class="card-title"><i class="fas fa-shield-alt"></i> Security This Week</h5>
              <p class="card-text">
                Stay up to date with the latest cybersecurity news, vulnerabilities, and security trends.
                Hosted by experts, this podcast delivers engaging discussions on real-world security threats and solutions.
              </p>
              <a href="https://www.securitythisweek.com/" class="btn btn-sm btn-primary" target="_blank">
                <i class="fas fa-headphones"></i> Listen Now
              </a>
            </div>
          </div>
        </div>

        <!-- .NET Rocks! -->
        <div class="col">
          <div class="card border-secondary h-100 shadow-sm">
            <div class="card-body text-center">
              <h5 class="card-title"><i class="fab fa-microsoft"></i> .NET Rocks!</h5>
              <p class="card-text">
                A must-listen for .NET developers! Covering topics from cloud computing to DevOps,
                this long-running podcast features insightful discussions with industry leaders.
              </p>
              <a href="https://www.dotnetrocks.com/" class="btn btn-sm btn-secondary" target="_blank">
                <i class="fas fa-microphone-alt"></i> Listen Now
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- Contact Section -->
  <section id="contact" class="d-print-none mb-5 text-center">
    <p class="lead fw-bold">Feel free to contact me on LinkedIn.</p>
    <div class="d-flex justify-content-center gap-3">
      <a href="https://www.linkedin.com/in/brent-gabel-a327569" class="btn btn-primary">
        <i class="bi bi-linkedin"></i> LinkedIn
      </a>
      <a href="content/Brent Gabel - Resume.pdf" class="btn btn-outline-primary" download>
        <i class="bi bi-file-earmark-arrow-down"></i> Download Resume
      </a>
    </div>
  </section>

</div>
