  <!-- Favorite Podcasts Section -->
  <section id="podcasts" class="d-print-none mb-5">
    <h2 class="text-center"><i class="fas fa-podcast"></i> My Favorite Podcasts</h2>
    <div class="container">
      <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Security This Week -->
        <div class="col">
          <div class="card border-primary h-100 shadow-sm">
            <div class="card-body text-center">
              <h5 class="card-title"><i class="fas fa-shield-alt"></i> Security This Week</h5>
              <p class="card-text">
                Stay up to date with the latest cybersecurity news, vulnerabilities, and security trends.
                Hosted by experts, this podcast delivers engaging discussions on real-world security threats and solutions.
              </p>
              <a href="https://www.securitythisweek.com/" class="btn btn-sm btn-primary" target="_blank">
                <i class="fas fa-headphones"></i> Listen Now
              </a>
            </div>
          </div>
        </div>

        <!-- .NET Rocks! -->
        <div class="col">
          <div class="card border-warning h-100 shadow-sm">
            <div class="card-body text-center">
              <h5 class="card-title"><i class="fab fa-microsoft"></i> .NET Rocks!</h5>
              <p class="card-text">
                A must-listen for .NET developers! Covering topics from cloud computing to DevOps,
                this long-running podcast features insightful discussions with industry leaders.
              </p>
              <a href="https://www.dotnetrocks.com/" class="btn btn-sm btn-warning" target="_blank">
                <i class="fas fa-microphone-alt"></i> Listen Now
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- Contact Section -->
  <section id="contact" class="d-print-none mb-5 text-center">
    <p class="lead fw-bold">Feel free to contact me on LinkedIn.</p>
    <div class="d-flex justify-content-center gap-3">
      <a href="https://www.linkedin.com/in/brent-gabel-a327569" class="btn btn-primary">
        <i class="bi bi-linkedin"></i> LinkedIn
      </a>
      <a href="content/Brent Gabel - Resume.pdf" class="btn btn-outline-primary" download>
        <i class="bi bi-file-earmark-arrow-down"></i> Download Resume
      </a>
    </div>
  </section>

  <!-- Image Modal -->
  <div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">@ImageTitle</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body text-center">
          <img src="images/@ImageFileName" class="img-fluid rounded" alt="@ImageTitle">
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>
</div>
